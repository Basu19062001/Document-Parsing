# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local settings:
#   copy .env.example .env
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True

# Swagger / ReDoc Documentation Access Credentials (HTTP Basic Auth)
DOCS_USERNAME=admin
DOCS_PASSWORD=admin123

# Database Connection (PostgreSQL + asyncpg)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=document_parsing_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Optional: Complete Database Connection URL Override
# (If specified, this takes precedence over individual DB_* fields above)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/document_parsing_db
